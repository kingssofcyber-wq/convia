# Hostinger MySQL connection. Use 127.0.0.1, not localhost.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=YOUR_HOSTINGER_DB_USER
DB_PASSWORD=YOUR_HOSTINGER_DB_PASSWORD
DB_NAME=YOUR_HOSTINGER_DB_NAME

# Set a long, unique password only for /admin/ads.
CONVIA_ADS_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# At least 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONVIA_ADS_SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS

# Your existing AdSense publisher ID (public identifier, not a password).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-7776844434912624
