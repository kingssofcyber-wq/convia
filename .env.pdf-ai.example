# Set these in the server environment only. Never expose the key to browser code.
# Do not commit .env.local or any file containing the real API key.
OPENAI_API_KEY=replace-with-server-side-key
OPENAI_MODEL=gpt-6-luna

# Required for certificate-backed PAdES signing and password-known PDF unlock.
# Use an authenticated HTTPS Gotenberg 9 service that you control or trust.
GOTENBERG_URL=https://your-private-pdf-engine.example
GOTENBERG_USERNAME=replace-with-engine-user
GOTENBERG_PASSWORD=replace-with-strong-engine-password
