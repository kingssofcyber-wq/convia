# Add these in Hostinger's Node.js application environment (server-side only).
# Do not commit real credentials or this file renamed to .env.
GOTENBERG_URL=https://your-private-pdf-engine.example.com
GOTENBERG_USERNAME=convia-api
GOTENBERG_PASSWORD=CHANGE_THIS_LONG_RANDOM_PASSWORD

# Optional: enables Chat with PDF and AI Summarize. API key and billing must be managed by the site owner/adult guardian.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
