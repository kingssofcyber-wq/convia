# Public project values. Publishable/anon key is safe for browser use only with proper Supabase security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only key. NEVER prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY

# Comma-separated email addresses that are allowed into /admin/ads.
CONVIA_ADS_ADMIN_EMAILS=your-admin-email@example.com

# Existing Convia AdSense publisher.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-7776844434912624
